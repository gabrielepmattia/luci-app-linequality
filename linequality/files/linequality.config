config linequality 'main'
	option enabled '1'
	option interface 'wan'
	list target 'gateway'
	list target '1.1.1.1'
	list target '8.8.8.8'
	option down_after '3'
	option data_dir '/etc/linequality'
	option hourly_retention_days '90'
	option daily_retention_days '1095'
	option speedtest_schedule ''
	option speedtest_duration '10'
	option speedtest_concurrent '3'
	option speedtest_server ''
	option interface6 ''
	option loss_threshold '5'
	option dns_enabled '1'
	option dns_server '127.0.0.1'
	list dns_name 'openwrt.org'
	list dns_name 'wikipedia.org'
	list dns_name 'example.com'
	option dns_interval '30'
	option plan_down ''
	option plan_up ''
	option notify_url ''
	option notify_type 'ntfy'
	option notify_token ''
	option notify_language 'en'
	option notify_min_outage '60'
	option notify_loss '0'
	option notify_speed_pct '0'
	option notify_gap '1'
